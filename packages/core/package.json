{
  "name": "@zineddinebk/grid-core",
  "version": "0.1.1",
  "description": "Headless data grid engine — sort, filter, group, tree data, virtual scroll, and edit history",
  "license": "MIT",
  "author": "ZineddineBk09",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZineddineBk09/Open-Source-Data-Grid-Design-System.git",
    "directory": "packages/core"
  },
  "homepage": "https://zineddinebk.github.io/Open-Source-Data-Grid-Design-System/",
  "bugs": {
    "url": "https://github.com/ZineddineBk09/Open-Source-Data-Grid-Design-System/issues"
  },
  "keywords": ["data-grid", "table", "headless", "typescript", "zustand", "virtual-scroll"],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  }
}
