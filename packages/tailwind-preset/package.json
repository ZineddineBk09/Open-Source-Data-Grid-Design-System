{
  "name": "@zineddinebk/grid-tailwind-preset",
  "version": "0.1.1",
  "description": "Tailwind CSS preset and design tokens for @zineddinebk/grid-react and @zineddinebk/grid-vue",
  "license": "MIT",
  "author": "ZineddineBk09",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZineddineBk09/Open-Source-Data-Grid-Design-System.git",
    "directory": "packages/tailwind-preset"
  },
  "homepage": "https://zineddinebk09.github.io/Open-Source-Data-Grid-Design-System/",
  "bugs": {
    "url": "https://github.com/ZineddineBk09/Open-Source-Data-Grid-Design-System/issues"
  },
  "keywords": ["tailwindcss", "tailwind", "design-tokens", "data-grid", "preset"],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": ["dist", "src/styles.css"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "tailwindcss": "^4.1.8",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  }
}
