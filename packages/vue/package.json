{
  "name": "@zineddinebk/grid-vue",
  "version": "0.1.1",
  "description": "Vue 3 data grid component — virtual scroll, filters, pinning, tree data, and inline editing",
  "license": "MIT",
  "author": "ZineddineBk09",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZineddineBk09/Open-Source-Data-Grid-Design-System.git",
    "directory": "packages/vue"
  },
  "homepage": "https://zineddinebk.github.io/Open-Source-Data-Grid-Design-System/",
  "bugs": {
    "url": "https://github.com/ZineddineBk09/Open-Source-Data-Grid-Design-System/issues"
  },
  "keywords": ["data-grid", "vue", "vue3", "table", "typescript", "tailwind", "virtual-scroll", "datagrid"],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": ["dist", "src/styles.css"],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@zineddinebk/grid-core": "workspace:*"
  },
  "devDependencies": {
    "@zineddinebk/grid-tailwind-preset": "workspace:*",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.3",
    "vue": "^3.5.16",
    "vue-tsc": "^2.2.10"
  },
  "peerDependencies": {
    "vue": ">=3.4"
  }
}
